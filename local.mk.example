# Copy to local.mk (it doesn't go to git; a .env with the same lines works too)
OPENROUTER_API_KEY = sk-or-...
# a proxy for requests to OpenRouter (socks5h://… or http://…); they then go through curl
# OPENROUTER_PROXY = socks5h://127.0.0.1:1080
# where frames are drawn: auto by default — the GPU if there is one, otherwise the software SwiftShader;
# gpu / cpu — set explicitly
# CAPTURE_GL = auto
# rendering without overheating: ffmpeg at low priority with 2 threads, pauses between frames (or make video COOL=1)
# CAPTURE_COOL = 1
# the codec: by default on macOS — the hardware h264_videotoolbox, otherwise libx264; set explicitly: videotoolbox / x264
# CAPTURE_ENCODER = x264

# the site (make site → make deploy): the folder on the server that nginx serves (deploy/README.md)
# DEPLOY = ssh://nemilya-me/var/www/grin
# SITE_URL = https://grin.nemilya.me

# media (pictures, narration) — the repository laid over stories/ (make media-pull / media-push); default:
# MEDIA_REMOTE = git@github.com:nemilya/grin-media.git   (by default — like grin's own origin, grin → grin-media)
